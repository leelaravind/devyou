{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["**/.env.*local", "tsconfig.base.json"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "build/**", ".react-router/**"] },
    "typecheck": { "dependsOn": ["^build", "cf-typegen"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "test:unit": { "dependsOn": ["^build"], "outputs": [] },
    "cf-typegen": { "cache": false, "outputs": ["worker-configuration.d.ts"] },
    "dev": { "cache": false, "persistent": true }
  }
}
