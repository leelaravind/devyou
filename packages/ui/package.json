{
  "name": "@devyou/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stitch-derived design system, rebuilt as typed reusable components",
  "exports": {
    ".": "./src/index.ts",
    "./styles/theme.css": "./src/styles/theme.css",
    "./*": "./src/*.tsx",
    "./styles/fonts.css": "./src/styles/fonts.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@devyou/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@devyou/config": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "@types/node": "^22.19.1",
    "jsdom": "^28.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
